// TutorConnect – zsamo adatbázis, dbdiagram.io (DBML) formátumban
// Használat: dbdiagram.io -> Go to app -> töröld a példakódot -> illeszd be ezt.

Enum user_role {
  STUDENT
  TUTOR
  ADMIN
}

Enum booking_status {
  PENDING
  CONFIRMED
  REJECTED
  COMPLETED
  CANCELLED
}

Table users {
  id int [pk, increment]
  full_name varchar(60) [not null]
  email varchar(100) [not null, unique]
  password_hash varchar(255) [not null]
  role user_role [not null]
  bio text [not null]
  hourly_rate decimal [not null]
  created_at timestamp
  school_level varchar(30)
  grade varchar(30)
  deleted_at timestamp
}

Table subjects {
  id int [pk, increment]
  name varchar(30) [not null, unique]
  category varchar(30) [not null]
}

Table tutor_subjects {
  tutor_id int [pk, not null]
  subject_id int [pk, not null]
  hourly_rate int [not null, default: 0]
}

Table student_subjects {
  student_id int [pk, not null]
  subject_id int [pk, not null]
}

Table availabilities {
  id int [pk, increment]
  tutor_id int [not null]
  start_time datetime [not null]
  end_time datetime [not null]
  is_booked boolean [default: false]
}

Table bookings {
  id int [pk, increment]
  student_id int
  tutor_id int
  subject_id int
  start_time timestamp
  end_time timestamp
  status_ booking_status
  created_at timestamp
  price int
  note varchar(300)
}

Table reviews {
  id int [pk, increment]
  booking_id int [unique]
  rating int [not null, note: '1-5 csillag']
  comment_ text
  crated_at timestamp
}

Table conversations {
  id int [pk, increment]
  student_id int [not null]
  tutor_id int [not null]
  created_at timestamp [not null]

  indexes {
    (student_id, tutor_id) [unique]
  }
}

Table messages {
  id int [pk, increment]
  conversation_id int [not null]
  sender_id int [not null]
  content text [not null]
  is_read boolean [not null, default: false]
  created_at timestamp [not null]
  attachment_name varchar(255)
  attachment_path varchar(255)
  attachment_type varchar(100)
  attachment_size int
  deleted_at timestamp
  edited_at timestamp
}

Ref: availabilities.tutor_id > users.id
Ref: bookings.student_id > users.id
Ref: bookings.tutor_id > users.id
Ref: bookings.subject_id > subjects.id
Ref: reviews.booking_id - bookings.id
Ref: conversations.student_id > users.id
Ref: conversations.tutor_id > users.id
Ref: messages.conversation_id > conversations.id
Ref: messages.sender_id > users.id
Ref: tutor_subjects.tutor_id > users.id
Ref: tutor_subjects.subject_id > subjects.id
Ref: student_subjects.student_id > users.id
Ref: student_subjects.subject_id > subjects.id
